{
  "name": "agentcart",
  "private": true,
  "workspaces": [
    "server",
    "dashboard",
    "mcp-server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "build": "npm run build --workspace=server && npm run build --workspace=dashboard",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "start": "npm run start --workspace=server",
    "testnet:login": "npm run testnet:login --workspace=server",
    "testnet:setup": "npm run testnet:setup --workspace=server",
    "testnet:pay": "npm run client --workspace=server"
  },
  "dependencies": {
    "@x402/avm": "^2.22.0",
    "@x402/core": "^2.22.0",
    "@x402/extensions": "^2.22.0",
    "@x402/fetch": "^2.22.0",
    "@x402/hono": "^2.22.0"
  }
}
