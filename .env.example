# === Server ===
PORT=3001
X402_PORT=4021
NODE_ENV=development

# === Algorand / x402 ===
# Use 'testnet' for testing, 'mainnet' for competition
ALGORAND_NETWORK=testnet
# Your Algorand payTo address (same for all endpoints = Composite entry)
# Fund it + opt into USDC (TestNet ASA 10458941, MainNet ASA 31566704)
AGENTCART_WALLET_ADDRESS=XXXXX
# GoPlausible facilitator (same for testnet and mainnet)
X402_FACILITATOR=https://facilitator.goplausible.xyz

# === Agent client (payer) ===
# 25-word mnemonic of the agent wallet that pays for calls
# Create a second wallet, fund with test ALGO + USDC, then put its mnemonic here
AGENT_PRIVATE_KEY=""

# === Algorand node (for on-chain settlement) ===
# Optional: override the default public nodes (algonode)
# ALGOD_SERVER=https://testnet-api.algonode.cloud
# INDEXER_SERVER=https://testnet-idx.algonode.cloud

# === Provider API Keys ===
LINKEDIN_API_KEY=xxx
LINKEDIN_API_BASE_URL=https://api.brightdata.com
TWITTER_BEARER_TOKEN=xxx
OPENWEATHER_API_KEY=xxx
EMAIL_VERIFICATION_API_KEY=xxx

# === Database ===
DATABASE_URL=file:./data/agentcart.db

# === Dashboard Auth ===
DASHBOARD_PASSPHRASE=your-secret-here
JWT_SECRET=random-secret-string

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60