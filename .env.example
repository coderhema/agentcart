# === Server ===
PORT=3001
NODE_ENV=development

# === Algorand / x402 ===
# Use 'testnet' for testing, 'mainnet' for competition
ALGORAND_NETWORK=testnet
# Your Algorand payTo address (same for all endpoints = Composite entry)
AGENTCART_WALLET_ADDRESS=XXXXX
# GoPlausible facilitator (same for testnet and mainnet)
X402_FACILITATOR=https://api.go-plausible.xyz

# === Provider API Keys ===
LINKEDIN_API_KEY=xxx
LINKEDIN_API_BASE_URL=https://api.brightdata.com
TWITTER_BEARER_TOKEN=xxx
OPENWEATHER_API_KEY=xxx
EMAIL_VERIFICATION_API_KEY=xxx

# === Database ===
DATABASE_URL=file:./data/agentcart.db

# === Dashboard Auth ===
DASHBOARD_PASSPHRASE=your-secret-here
JWT_SECRET=random-secret-string

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60